        MENUITEM "加载通道数据",                      ID_LoadJiggerData
        MENUITEM "加载外部文件",                      ID_LoadTxtJigger
        MENUITEM SEPARATOR
        MENUITEM "保存数据",                        ID_SaveJiggerToTxt
        MENUITEM "保存视图",                        ID_SaveJiggerToImage
    END
END

IDR_SAVERECORD MENU 
BEGIN
    POPUP "_pop_"
    BEGIN
        MENUITEM "保存日志",                        ID_SAVERECORDTOTEXT
    END
END

IDR_CAMMENU MENU 
BEGIN
    POPUP "_pop_"
    BEGIN
        MENUITEM "保存数据",                        ID_SaveCamData
        MENUITEM "保存视图",                        ID_SaveCamToPic
    END
END

IDR_3DFREQPOPUP MENU 
BEGIN
    POPUP "PopUp"
    BEGIN
        MENUITEM "新建三维频谱瀑布图",                   ID_3DFreqNew
        MENUITEM "新建三维波形瀑布图",                   ID_T3DWAVENEW
        MENUITEM SEPARATOR
        MENUITEM "设置坐标轴范围",                     ID_SetAxisRange
        MENUITEM "设置字体",                        ID_SETFONT
        MENUITEM "设置曲线状态",                      ID_SETCURVE
        MENUITEM SEPARATOR
        MENUITEM "保存当前视图",                      ID_T3dSaveImage
        MENUITEM "批量存储视图",                      ID_SaveT3dViewBatDlg
        MENUITEM "设置标题",                        ID_3D_TITLE
    END
END


