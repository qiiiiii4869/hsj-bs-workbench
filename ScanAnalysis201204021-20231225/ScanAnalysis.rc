            MENUITEM "试验图谱",                        ID_ExamGrap
            MENUITEM "试验分析",                        ID_ExamAnysTB
        END
        MENUITEM SEPARATOR
        POPUP "外观主题(&A)"
        BEGIN
            MENUITEM "浅色扁平（默认）",                  ID_VIEW_APPLOOK_MODERN
            MENUITEM "Office &XP",                  ID_VIEW_APPLOOK_XP
            MENUITEM "&Windows XP",                 ID_VIEW_APPLOOK_WIN_XP
            MENUITEM "Office 200&3",                ID_VIEW_APPLOOK_2003
            MENUITEM "Visual Studio 200&5",         ID_VIEW_APPLOOK_VS2005
            MENUITEM "Visual Studio 200&8",         ID_VIEW_APPLOOK_VS2008
        END
        POPUP "视图窗口颜色(&C)"
        BEGIN
            MENUITEM "灰色",                          ID_TABGRAY
            MENUITEM "彩色",                          ID_TABCOLOUR
        END
    END
    POPUP "波形频谱(&W)"
    BEGIN
        MENUITEM "设置标题",                        ID_SetTitle
        POPUP "峰峰值设定"
        BEGIN
            MENUITEM "置信度97%",                      ID_NINESEVEN
            MENUITEM "置信度95%",                      ID_NINEFIVE
            MENUITEM "置信度100%",                     ID_ONEHUNDRED
        END
        MENUITEM SEPARATOR
        POPUP "波形图"
        BEGIN
            MENUITEM "捡取浮动点",                       ID_CurrorFloat
            MENUITEM "捡取临近点",                       ID_CurrorNearestPoint
            MENUITEM SEPARATOR
            MENUITEM "平移　XY",                       ID_Moving
            MENUITEM "放大  X轴",                      ID_XZOOM
            MENUITEM "放大  Y轴",                      ID_YZOOM
            MENUITEM "放大  XY",                      ID_Zoom
            MENUITEM SEPARATOR
            MENUITEM "撤销",                          ID_UnZoom
            MENUITEM SEPARATOR
            MENUITEM "重绘",                          ID_resume
            MENUITEM "标注",                          ID_Annotations
        END
        POPUP "频谱图"
        BEGIN
            MENUITEM "捡取临近点",                       ID_CurrorNearestPointF
            MENUITEM SEPARATOR
            MENUITEM "平移  X轴",                      ID_XMovingF
            MENUITEM "放大  X轴",                      ID_XZOOMF
            MENUITEM "放大  XY",                      ID_ZoomF
            MENUITEM SEPARATOR
            MENUITEM "撤销",                          ID_UnZoomF
            MENUITEM SEPARATOR
            MENUITEM "重绘",                          ID_resumeF
        END
        POPUP "波形频谱图"
        BEGIN
            MENUITEM "波形图",                         ID_WaveGraph
            MENUITEM "频谱图",                         ID_FRAQGRAPH
            MENUITEM "波形频谱图",                       ID_WAVEFRAQGRAP
        END
        MENUITEM SEPARATOR
        MENUITEM "整周期FFT",                      ID_FullPeriodFFT
        MENUITEM SEPARATOR
        MENUITEM "显示健相",                        ID_KeyPhaseVisual
        MENUITEM SEPARATOR
        MENUITEM "添加通道数据",                      ID_AddChnData
        MENUITEM "添加移动趋势",                      ID_AddMobTrend
        MENUITEM SEPARATOR
        MENUITEM "波形滤波",                        ID_WaveFilter
        MENUITEM "恢复滤波前数据",                     ID_ResumeFilter
        MENUITEM SEPARATOR
        POPUP "保存图像"
        BEGIN
            MENUITEM "波形图",                         ID_SaveSingleView
            MENUITEM "全图",                          ID_SaveAllView
            MENUITEM "自定义",                         ID_CustomSaveAllView
        END
        MENUITEM "保存通道数据",                      ID_TextSave
        MENUITEM "输出word文档",                    ID_WordReport
        MENUITEM "输出excel报表",                   ID_ExcelReport
        MENUITEM SEPARATOR
        MENUITEM "批量存储图像",                      ID_SAVEPICBAT
        MENUITEM "批量存储通道数据",                    ID_SAVETXTDATA
        MENUITEM "批量存储为Excel文件",                ID_SAVEEXCELDATA
        MENUITEM "批量存储为word文件",                 ID_SAVEWORDDATA
    END
    POPUP "波形长图(&L)"
    BEGIN
        MENUITEM "新建...",                       ID_StripChartGen
        MENUITEM SEPARATOR
        MENUITEM "设置区域信息",                      ID_MENUITEMSetRange
        MENUITEM "添加信号",                        ID_MENUITEMAddSignal
        MENUITEM "添加分组",                        ID_MENUITEMGroup
        MENUITEM SEPARATOR
        MENUITEM "保存视图",                        ID_MENUITEMSaveToImage
    END
