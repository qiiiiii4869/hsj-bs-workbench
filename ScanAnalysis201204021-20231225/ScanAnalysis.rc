IDR_MAINFRAME MENU 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开分拣文件...",                   ID_FILEOPENDATA
        MENUITEM "文件属性",                        ID_FILEPproperty
        MENUITEM SEPARATOR
        MENUITEM "保存日志",                        ID_SAVERECORDTOTEXT
        MENUITEM SEPARATOR
        MENUITEM "载入数据FFT",                     ID_LODDATA_FFT
        MENUITEM SEPARATOR
        MENUITEM "刷新",                          ID_REFRESHAPP
        MENUITEM "退出",                          ID_APP_EXIT
    END
    POPUP "视图(&V)"
    BEGIN
        MENUITEM "试验数据导航",                      ID_ExamData
        MENUITEM "消息输出窗口",                      ID_MsgOut
        MENUITEM "状态栏(&S)",                     ID_VIEW_STATUS_BAR
        POPUP "工具栏(&T)"
        BEGIN
            MENUITEM "文件操作",                        ID_FileTB
            MENUITEM "图形操作",                        ID_WAVETB
