        MENUITEM SEPARATOR
        MENUITEM "平均值",                         ID_TrendMean
        MENUITEM "中间值",                         ID_TrendMedian
        MENUITEM "有效值",                         ID_TrendRMS
        MENUITEM "峰峰值",                         ID_TrendPPValue
        MENUITEM SEPARATOR
