        MENUITEM SEPARATOR
        MENUITEM "保存当前视图",                      ID_T3dSaveImage
        MENUITEM "批量存储视图",                      ID_SaveT3dViewBatDlg
    END
    POPUP "轴心轨迹(&A)"
    BEGIN
        MENUITEM "新建...",                       ID_AXISNEW
        MENUITEM SEPARATOR
        MENUITEM "撤销",                          ID_AxisUnZoom
        MENUITEM "重绘",                          ID_AxisResume
        MENUITEM SEPARATOR
        MENUITEM "X波形滤波",                       ID_XWaveFilter
        MENUITEM "Y波形滤波",                       ID_YWaveFilter
